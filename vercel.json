{
  "rewrites": [
    {
      "source": "/api/clips/publish",
      "destination": "/api/clips/publish"
    },
    {
      "source": "/api/clips/stream",
      "destination": "/api/clips/stream"
    },
    {
      "source": "/api/clip",
      "destination": "/api/clip"
    },
    {
      "source": "/api/clips/:id(\\d+)",
      "destination": "/api/clip?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/not-found"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

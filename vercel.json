{
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth/:path*" },
    { "source": "/api/upload/:path*", "destination": "/api/upload/:path*" },
    { "source": "/api/clips/:path*", "destination": "/api/clips/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

{
  "functions": {
    "api/original.js": {
      "maxDuration": 60,
      "includeFiles": ".original-backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/original"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

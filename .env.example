# Public browser configuration; obtain from your Supabase project settings.
# Vite also maps SUPABASE_URL and SUPABASE_ANON_KEY at build time.
# Explicit nonempty VITE_ values take precedence.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional existing Arena backend ORIGIN, not a URL ending in /api.
# Must implement the original username/password cookie-session and GDNA APIs.
VITE_API_URL=
# GDNA provider and Supabase service-role secrets belong ONLY on the backend.
# No GDNA backend/provider contract or Replit Secrets were present in this checkout.
